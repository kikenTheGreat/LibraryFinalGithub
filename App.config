<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<appSettings>
		<!-- Email Configuration (Gmail) -->
		<add key="AppEmail" value="kentjocellusdoc@gmail.com"/>
		<add key="AppPassword" value="zgyexkcgtaiebfsf"/>

		<!-- SMS Configuration (Semaphore API - Philippine SMS Provider) -->
		<!-- Sign up at: https://semaphore.co/ and get your API key -->
		<add key="SemaphoreApiKey" value="YOUR_SEMAPHORE_API_KEY_HERE"/>

		<!-- Notification Settings -->
		<add key="EnableEmailNotifications" value="true"/>
		<add key="EnableSmsNotifications" value="false"/>
		<add key="NotificationCheckInterval" value="30"/>
		<!-- Minutes -->

		<!-- Email Templates -->
		<add key="EmailFromName" value="CGC Library System"/>
		<add key="EmailFooterText" value="This is an automated message. Please do not reply."/>

		<!-- SMS Settings -->
		<add key="SmsSenderName" value="CGC Library"/>
		<!-- Max 11 characters -->
		<add key="SmsMaxLength" value="160"/>
		<!-- Single SMS limit -->
	</appSettings>
</configuration>
